# Puerto en el que escucha el backend (Render lo asigna automáticamente)
PORT=3000

# Cadena de conexión completa a PostgreSQL (Aiven / Render / etc.)
# Si se define, tiene prioridad sobre DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME
DATABASE_URL=postgres://usuario:password@host:puerto/basededatos?sslmode=require

# Forzar/desactivar SSL en la conexión a la base de datos (por defecto true)
# DB_SSL=false

# Alternativa a DATABASE_URL: variables individuales (solo si no se usa DATABASE_URL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=skillmatch_app
DB_PASSWORD=CAMBIAR_EN_ENTORNO_LOCAL
DB_NAME=skillmatch

# CORS: origen principal permitido (frontend)
FRONTEND_ORIGIN=http://localhost:3000
# Orígenes adicionales separados por coma (útil para preview deployments de Vercel)
FRONTEND_ORIGINS=

# Autenticación
JWT_SECRET=CAMBIA_ESTA_CLAVE_POR_UNA_LARGA_Y_ALEATORIA

# WebAuthn
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000

# Cloudinary (subida de imágenes/evidencias)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google (envío de correos)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_MAIL=
GOOGLE_REFRESH_TOKEN=

# Cloudinary: recomendado/obligatorio en produccion para persistencia de fotos y multimedia
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
